# Copy to .env, or run `pnpm manifest env` to fill it in interactively.

# ── Supabase (Project Settings → API) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Postgres (Project Settings → Database → Connection string) ──────────────
# Transaction pooler (port 6543): used by the app at runtime (src/db/index.ts).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Direct / session connection (port 5432): used by drizzle-kit (drizzle.config.ts) and `pnpm manifest`.
DIRECT_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Shared secret for the optional /api/webhooks/auth-users webhook (x-webhook-secret header).
# Not needed when the auth sync trigger is installed (`pnpm manifest auth-sync`).
AUTH_WEBHOOK_SECRET=

# ── Display (optional; defaults shown) ───────────────────────────────────────
# Time zone used to show and enter dates and times.
# NEXT_PUBLIC_APP_TIMEZONE=Europe/Bucharest
# Initial overview mode: "list" (cards) or "table" (grid).
# NEXT_PUBLIC_DEFAULT_VIEW_MODE=list
# Show a number before each detail tab label.
# NEXT_PUBLIC_ENABLE_NUMBERED_TABS=false


# Live preview in the CMS: any long random text (the CMS signs preview links with it).
PREVIEW_SECRET=
